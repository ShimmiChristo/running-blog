---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const categoryLabel = { shoes: 'Shoes', merch: 'Merch', training: 'Training' };
const published = article.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={article.data.title} description={article.data.description}>
  <article class="article-page">
    <header class="article-header"><a class="back-link" href="/articles/">← All answers</a><p class="eyebrow">{categoryLabel[article.data.category]} · {article.data.readingTime}</p><h1>{article.data.title}</h1><p class="dek">{article.data.description}</p><div class="byline">By {article.data.author} · Published {published}</div></header>
    <div class="article-layout"><aside><div class="aside-label">In this answer</div><a href="#the-short-answer">The short answer</a><a href="#what-to-prioritize">What to prioritize</a><a href="#final-checklist">Final checklist</a></aside><div class="prose"><Content /></div></div>
  </article>
</BaseLayout>

<style>
  .article-page { padding-bottom: 90px; }
  .article-header { max-width: 820px; padding: 74px 0 68px; }
  .back-link { display: inline-block; margin-bottom: 58px; color: var(--muted); font: 11px 'DM Mono', monospace; }
  .back-link:hover { color: var(--orange); }
  h1 { margin: 0 0 23px; font-size: clamp(46px, 6vw, 82px); line-height: .94; letter-spacing: -.1em; }
  .dek { max-width: 590px; color: var(--muted); font-size: 17px; line-height: 1.5; }
  .byline { margin-top: 34px; color: var(--muted); font: 10px 'DM Mono', monospace; }
  .article-layout { display: grid; grid-template-columns: 185px minmax(0, 680px); gap: 70px; padding-top: 55px; border-top: 1px solid var(--line); }
  aside { display: grid; align-content: start; gap: 15px; color: var(--muted); font: 11px 'DM Mono', monospace; }
  aside a:hover { color: var(--orange); }
  .aside-label { margin-bottom: 6px; color: var(--orange); font-size: 10px; text-transform: uppercase; }
  .prose { font-size: 16px; line-height: 1.7; }
  .prose :global(h2) { margin: 46px 0 17px; font-size: 31px; letter-spacing: -.07em; }
  .prose :global(h3) { margin: 35px 0 9px; font-size: 20px; letter-spacing: -.04em; }
  .prose :global(p) { margin: 0 0 22px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 25px; }
  .prose :global(strong) { font-weight: 600; }
  @media (max-width: 700px) { .article-header { padding-top: 55px; } .back-link { margin-bottom: 45px; } .article-layout { display: block; padding-top: 32px; } aside { display: none; } .prose { font-size: 15px; } }
</style>
