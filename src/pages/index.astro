---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';

const articles = (await getCollection('articles')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = articles.find((article) => article.data.featured) ?? articles[0];
const latest = articles.filter((article) => article.id !== featured?.id).slice(0, 3);
const categoryLabel = { shoes: 'Shoes', merch: 'Merch', training: 'Training' };
---
<BaseLayout title="Run smarter" description="Clear answers about running shoes, apparel, and gear for everyday runners.">
  <section class="home-hero">
    <div>
      <p class="eyebrow">A practical field guide for runners</p>
      <h1>Run more.<br /><em>Guess less.</em></h1>
      <p class="intro">Clear answers on running shoes, race-day gear, and the stuff nobody explains on the box.</p>
      <a class="button" href="/articles/">Find an answer <span>→</span></a>
    </div>
    <div class="hero-note"><span class="note-number">01</span><strong>Start with your question.</strong><span>Find the right shoe, layer, or bit of kit without the noise.</span></div>
  </section>

  <section class="featured-section" aria-labelledby="featured-title">
    <div class="section-heading"><div><p class="eyebrow">Start here</p><h2 id="featured-title">The answer desk</h2></div><a class="text-link" href="/articles/">Browse all answers <span>↗</span></a></div>
    {featured && <a class="featured-card" href={`/articles/${featured.id}/`}>
      <div><p class="article-type">{categoryLabel[featured.data.category]} · {featured.data.readingTime}</p><h3>{featured.data.title}</h3><p class="card-description">{featured.data.description}</p><span class="read-link">Read the guide →</span></div>
      <div class="featured-index">FIELD<br /><strong>NOTE<br />{featured.id.slice(0, 2).toUpperCase()}</strong></div>
    </a>}
  </section>

  <section class="latest-section" aria-labelledby="latest-title">
    <div class="section-heading"><div><p class="eyebrow">Keep exploring</p><h2 id="latest-title">Latest answers</h2></div></div>
    <div class="article-list">
      {latest.map((article) => <a class="article-row" href={`/articles/${article.id}/`}>
        <span class="article-category">{categoryLabel[article.data.category]}</span><h3>{article.data.title}</h3><span class="article-time">{article.data.readingTime} <b>↗</b></span>
      </a>)}
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero { display: grid; grid-template-columns: 1fr .8fr; gap: 14vw; align-items: end; padding: 100px 5vw 115px; margin: 0 -28px; background: var(--cream); }
  h1 { margin: 0 0 25px; font-size: clamp(64px, 8vw, 112px); line-height: .86; letter-spacing: -.1em; font-weight: 600; }
  h1 em { color: var(--orange); font-family: Georgia, serif; font-weight: 400; letter-spacing: -.1em; }
  .intro { max-width: 350px; margin: 0 0 29px; color: var(--muted); font-size: 15px; line-height: 1.55; }
  .hero-note { max-width: 270px; display: grid; gap: 14px; padding: 24px 0 0; border-top: 1px solid var(--ink); font-size: 14px; line-height: 1.4; }
  .hero-note strong { font-size: 21px; letter-spacing: -.05em; }
  .hero-note span:last-child { color: var(--muted); font-size: 12px; }
  .note-number, .article-category, .article-time, .article-type { color: var(--orange); font: 10px 'DM Mono', monospace; text-transform: uppercase; }
  .featured-section, .latest-section { padding: 83px 0; }
  .latest-section { border-top: 1px solid var(--line); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; margin-bottom: 40px; }
  h2 { margin: 0; font-size: clamp(34px, 4vw, 54px); line-height: .95; letter-spacing: -.08em; }
  .text-link { color: var(--muted); font: 11px 'DM Mono', monospace; }
  .text-link span { color: var(--orange); margin-left: 9px; }
  .featured-card { min-height: 300px; display: flex; justify-content: space-between; padding: 34px; background: var(--green); color: var(--paper); }
  .featured-card:hover { background: #334f44; }
  .featured-card h3 { max-width: 600px; margin: 24px 0 16px; font-size: clamp(30px, 4vw, 54px); line-height: .98; letter-spacing: -.08em; }
  .card-description { max-width: 410px; color: #b5c1b9; font-size: 13px; line-height: 1.5; }
  .read-link { display: inline-block; margin-top: 25px; color: var(--lime); font: 11px 'DM Mono', monospace; }
  .featured-index { color: var(--lime); font: 11px/1.45 'DM Mono', monospace; text-align: right; }
  .featured-index strong { font-size: 18px; }
  .article-list { border-top: 1px solid var(--line); }
  .article-row { display: grid; grid-template-columns: 130px 1fr 110px; align-items: center; gap: 22px; padding: 23px 0; border-bottom: 1px solid var(--line); }
  .article-row:hover h3 { color: var(--orange); }
  .article-row h3 { margin: 0; font-size: 20px; line-height: 1.05; letter-spacing: -.05em; font-weight: 500; }
  .article-time { color: var(--muted); text-align: right; }
  .article-time b { color: var(--orange); font-size: 15px; font-weight: 400; margin-left: 10px; }
  @media (max-width: 600px) { .home-hero { display: block; padding: 67px 20px 76px; margin: 0 -20px; } .hero-note { margin-top: 70px; } .section-heading { align-items: start; gap: 20px; } .featured-card { min-height: 350px; padding: 25px; } .article-row { grid-template-columns: 1fr 85px; gap: 8px; } .article-category { grid-column: 1 / -1; } .article-row h3 { font-size: 17px; } }
</style>
